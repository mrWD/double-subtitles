{
  "manifest_version": 3,
  "name": "Double Subtitles",
  "version": "1.0.5",
  "description": "A second, translated subtitle line for Netflix, Prime Video, Disney+, YouTube and Twitch. Click words to translate and save phrases.",
  "author": "Viktor Lavrov",
  "homepage_url": "https://github.com/mrwd/double-subtitles",
  "permissions": [
    "storage",
    "alarms",
    "tts"
  ],
  "default_locale": "en",
  "host_permissions": [
    "https://*.primevideo.com/*",
    "https://*.amazon.com/gp/video/*",
    "https://*.amazon.co.uk/gp/video/*",
    "https://*.amazon.de/gp/video/*",
    "https://*.amazon.co.jp/gp/video/*",
    "https://*.disneyplus.com/*",
    "https://*.netflix.com/*",
    "https://*.youtube.com/*",
    "https://*.twitch.tv/*",
    "https://*.max.com/*",
    "https://*.hbomax.com/*",
    "https://*.hulu.com/*",
    "https://ankiuser.net/*",
    "https://quizlet.com/*",
    "https://translate.googleapis.com/*",
    "https://raw.githubusercontent.com/mrWD/double-subtitles/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://translate.googleapis.com https://raw.githubusercontent.com; base-uri 'none'; form-action 'none'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/netflixBridge.js"
      ],
      "matches": [
        "https://*.netflix.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "css": [
        "assets/injectedCss.css"
      ],
      "js": [
        "src/i18n.js",
        "src/settings.js",
        "src/utils.js",
        "src/selectorsValidator.js",
        "src/selectors.js",
        "src/autofill.js",
        "src/serviceIntegrations.js",
        "src/cardMenu.js",
        "src/translationModal.js",
        "src/subtitlesManager.js",
        "src/sidebar.js",
        "src/subtitles.js",
        "content.js"
      ],
      "matches": [
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.de/gp/video/*",
        "https://*.amazon.co.jp/gp/video/*",
        "https://*.disneyplus.com/*",
        "https://*.netflix.com/*",
        "https://*.youtube.com/*",
        "https://*.twitch.tv/*",
        "https://*.max.com/*",
        "https://*.hbomax.com/*",
        "https://*.hulu.com/*",
        "https://ankiuser.net/*",
        "https://quizlet.com/*"
      ]
    }
  ]
}
