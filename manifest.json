{
  "manifest_version": 3,
  "name": "Double Subtitles",
  "version": "1.0.4",
  "description": "A second, translated subtitle line for Netflix, Prime Video, Disney+, YouTube and Twitch. Click words to translate and save phrases.",
  "author": "Viktor Lavrov",
  "homepage_url": "https://github.com/mrwd/double-subtitles",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "tts"
  ],
  "default_locale": "en",
  "host_permissions": [
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.co.jp/*",
    "*://*.disneyplus.com/*",
    "*://*.netflix.com/*",
    "*://*.youtube.com/*",
    "*://*.twitch.tv/*",
    "*://ankiuser.net/*",
    "*://quizlet.com/*",
    "https://translate.googleapis.com/*",
    "https://raw.githubusercontent.com/mrWD/double-subtitles/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/netflixBridge.js"
      ],
      "matches": [
        "*://*.netflix.com/*"
      ]
    },
    {
      "resources": [
        "_locales/*/messages.json"
      ],
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.co.jp/*",
        "*://*.disneyplus.com/*",
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.twitch.tv/*",
        "*://ankiuser.net/*",
        "*://quizlet.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "css": [ "assets/injectedCss.css" ],
      "js": [
        "src/i18n.js",
        "src/settings.js",
        "src/utils.js",
        "src/selectorsValidator.js",
        "src/selectors.js",
        "src/autofill.js",
        "src/savedCards.js",
        "src/serviceIntegrations.js",
        "src/cardMenu.js",
        "src/translationModal.js",
        "src/subtitlesManager.js",
        "src/sidebar.js",
        "src/subtitles.js",
        "content.js"
      ],
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.co.jp/*",
        "*://*.disneyplus.com/*",
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.twitch.tv/*",
        "*://ankiuser.net/*",
        "*://quizlet.com/*"
      ]
    }
  ]
}
